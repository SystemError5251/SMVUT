# Vorlage: kopieren nach .env (liegt in .gitignore) oder nach ~/.terminal/.env
# (Termux: ~/.terminal/.env, das legt scripts/termux-setup.sh an)

# YouTube: OAuth-Client vom Typ "Desktop-App" aus der Google Cloud Console
# Relativer Pfad: erst im aktuellen Ordner, dann in ~/.terminal/ gesucht
YOUTUBE_CLIENT_SECRETS=client_secret.json

# Instagram (Instagram Login): App-Secret nur nötig, um einen kurzlebigen
# Token gegen einen langlebigen zu tauschen
INSTAGRAM_APP_SECRET=

# TikTok: Login Kit (Desktop) + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Muss exakt so in der TikTok-App als Redirect-URI eingetragen sein
TIKTOK_REDIRECT_URI=http://localhost:3455/callback/

# Zwischenablage für Instagram: Cloudflare R2 (S3-kompatibel) oder AWS S3
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  |  AWS S3: leer lassen
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Token-Speicher: keyring (Standard) oder file (~/.terminal/tokens.json, Modus 600).
# Auf Termux automatisch file.
# TERMINAL_TOKEN_STORE=file
